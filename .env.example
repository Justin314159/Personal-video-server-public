# Optional environment overrides for Home Video Library.
# These win over config.toml. Copy and edit, never commit the real file:
#   systemd install:  sudo install -m 600 .env.example /etc/homelib/homelib.env
#   run.sh / dev:     cp .env.example .env
# Leave a line commented out to use the value from config.toml.

# Path to the TOML config (see packaging/config.example.toml).
# HOMELIB_CONFIG=/etc/homelib/config.toml

# Listen address: 127.0.0.1 (use with `tailscale serve`), "tailscale", or an IP.
# HOMELIB_BIND=127.0.0.1
# HOMELIB_PORT=8787

# Where the database, thumbnails and downloads live.
# HOMELIB_DATA_DIR=/var/lib/homelib
# HOMELIB_LIBRARY_DIR=/var/lib/homelib/library

# The two profile names, comma separated (only used when the database is first created).
# HOMELIB_PROFILE_NAMES=Profile 1,Profile 2

# Optional cookies.txt exported from YOUR OWN YouTube session. Treat it like a password.
# HOMELIB_COOKIES_FILE=/etc/homelib/youtube-cookies.txt

# 1 = fake YouTube for development and demos (no internet needed).
# HOMELIB_MOCK=0

# Used only in the docs and the iOS Shortcut guide. The app itself needs no hostname.
# YOUR_TAILSCALE_HOSTNAME=YOUR_SERVER_HOSTNAME.YOUR_TAILNET.ts.net
